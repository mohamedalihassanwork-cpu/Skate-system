# KOSHK SKATE ERP — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Application
NODE_ENV=development
PORT=3001

# Database (MySQL / MariaDB — DEC-015, DEC-022)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=koshk_skate
DB_USER=root
DB_PASSWORD=

# Authentication — DEC-024, DEC-028
# Both secrets must be cryptographically random strings (min 32 characters) in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION_JWT_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_BEFORE_PRODUCTION_JWT_REFRESH

# Token expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Seed Admin Credentials — DEC-026
# Used by `npm run db:seed` only. Change the password after first login.
# NEVER use these defaults in production — override via environment variables.
SEED_ADMIN_EMAIL=admin@koshkskate.com
SEED_ADMIN_PASSWORD=Koshk@12345
